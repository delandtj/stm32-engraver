(version 1)
# ADR 0003 Decision 5 / ADR 0005 Decision 3: KiCad's net class widths are
# defaults, not limits, so these rules make DRC catch a power net routed at
# the signal width. Necking down at small pads is allowed to about half the
# class width. The per-net floor check in tools/pcb5/check.py is stricter.
(rule "HighCurrent tracks"
  (condition "A.NetClass == 'HighCurrent'")
  (constraint track_width (min 0.5mm)))
(rule "5V tracks"
  (condition "A.NetClass == 'PWR_5V'")
  (constraint track_width (min 0.3mm)))
(rule "3V3 tracks"
  (condition "A.NetClass == 'PWR_3V3'")
  (constraint track_width (min 0.3mm)))
(rule "GND tracks"
  (condition "A.NetClass == 'GND'")
  (constraint track_width (min 0.3mm)))
